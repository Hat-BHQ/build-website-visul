COMPOSE_PROJECT_NAME=hq-platform

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-postgres-password
IDENTITY_DB=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=change-identity-password
HQA_DB=hqa_db
HQA_DB_USER=hqa_user
HQA_DB_PASSWORD=change-hqa-password
SYNC_DB=sync_db
SYNC_DB_USER=sync_user
SYNC_DB_PASSWORD=change-sync-password
HQS_DB=hqs_db
HQS_DB_USER=hqs_user
HQS_DB_PASSWORD=change-hqs-password

JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=24
SERVICE_TOKEN=replace-with-a-long-internal-service-token

RABBITMQ_USER=hq
RABBITMQ_PASSWORD=change-rabbitmq-password
REDIS_PASSWORD=change-redis-password
MINIO_ROOT_USER=hqminio
MINIO_ROOT_PASSWORD=change-minio-password

COOKIE_NAME=hq_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

BOOTSTRAP_SUPERADMIN_EMAIL=root@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_HQA_ADMIN_EMAIL=hqa.admin@example.com
BOOTSTRAP_HQA_ADMIN_PASSWORD=Admin123!
BOOTSTRAP_HQA_USER_EMAIL=hqa.user@example.com
BOOTSTRAP_HQA_USER_PASSWORD=User123!
